#!/usr/bin/env bash
# Regenerate Formula/ltext.rb for a release of ltext/ltext.
#
#   bin/update-formula [TAG]     # default: the latest release
#
# Asset checksums come from the release's SHA256SUMS. Prints the version.
set -euo pipefail
repo=https://github.com/ltext/ltext

tag=${1:-$(curl -fsSL -o /dev/null -w '%{url_effective}' "$repo/releases/latest" | sed 's|.*/tag/||')}
[[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "unexpected tag: $tag" >&2; exit 1; }
ver=${tag#v}

sums=$(curl -fsSL "$repo/releases/download/$tag/SHA256SUMS")
sum() {
  local s
  s=$(awk -v f="ltext-$ver-$1.tar.gz" '$2 == f { print $1 }' <<< "$sums")
  [[ -n "$s" ]] || { echo "no $1 archive in $tag's SHA256SUMS" >&2; exit 1; }
  echo "$s"
}
mac_arm=$(sum aarch64-apple-darwin) mac_intel=$(sum x86_64-apple-darwin)
linux_arm=$(sum aarch64-unknown-linux-musl) linux_intel=$(sum x86_64-unknown-linux-musl)

dl="$repo/releases/download/$tag/ltext-$ver"
cat > "$(dirname "$0")/../Formula/ltext.rb" <<RUBY
# Generated by bin/update-formula from the $tag release; don't edit by hand.
class Ltext < Formula
  desc "Text-file templating utility that treats files as higher-order functions"
  homepage "https://github.com/ltext/ltext"
  license "BSD-3-Clause"

  on_macos do
    on_arm do
      url "$dl-aarch64-apple-darwin.tar.gz"
      sha256 "$mac_arm"
    end
    on_intel do
      url "$dl-x86_64-apple-darwin.tar.gz"
      sha256 "$mac_intel"
    end
  end

  on_linux do
    on_arm do
      url "$dl-aarch64-unknown-linux-musl.tar.gz"
      sha256 "$linux_arm"
    end
    on_intel do
      url "$dl-x86_64-unknown-linux-musl.tar.gz"
      sha256 "$linux_intel"
    end
  end

  def install
    bin.install "ltext"
    doc.install "README.md"
  end

  test do
    assert_equal "ltext #{version}", shell_output("#{bin}/ltext --version").strip

    (testpath/"greet").write "{{ name }}\\nHello,\\n{{ name }}\\n"
    (testpath/"name").write "Homebrew"
    assert_equal "Hello,\\nHomebrew\\n", shell_output("#{bin}/ltext 'greet name'")
    assert_equal "Text -> Text\\n", shell_output("#{bin}/ltext --type greet")
  end
end
RUBY
echo "$ver"
